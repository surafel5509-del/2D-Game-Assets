<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumen2D Studio — the engine's editor and runtime player.

  One APK contains:
    * the project hub (MainActivity): create, import, export and play projects,
    * the editor (StudioActivity): scene tree, inspector, asset browser, script editor, console,
      all over a live viewport running the real engine,
    * the engine content itself (assets/packs/base + assets/samples/*), so the samples play offline
      and `lib://` resolves without any download.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/StudioTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StudioActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode"
            android:exported="false"
            android:label="@string/studio_name"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
